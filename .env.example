# Salin menjadi .env lalu isi nilai yang kosong. Jangan menaruh password atau kunci sungguhan di berkas contoh ini.
# Produksi: NODE_ENV=production, HOST=127.0.0.1, COOKIE_SECURE=true, TRUST_PROXY=true.
# Server menolak start bila kombinasi itu tidak lengkap. Akses dari luar hanya lewat reverse proxy HTTPS.
# Lihat docs/DEPLOY.md.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./backups
APP_TZ=Asia/Jakarta
ACCESS_HOURS=06:00-23:00
SESSION_HOURS=12

# Jangan isi SESSION_TIMER=off atau APP_FAKE_NOW_FILE di produksi. Server menolak start.
# Cookie sesi: HttpOnly dan SameSite=Lax selalu. Secure menyala bila ini true, atau bila proxy menyebut HTTPS.
COOKIE_SECURE=false
# true hanya bila aplikasi di belakang reverse proxy dan port aplikasi tidak terbuka ke internet.
TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# Akun supervisor pertama. Kosong = password acak ditulis sekali ke data/first-run-credentials.txt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Kosong = endpoint bot nonaktif. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_KEY=
